{
  "openapi": "3.1.0",
  "info": {
    "title": "manai team API \u2014 planning contract",
    "version": "0.2.0",
    "description": "Draft contract. No server implemented. Example values are original synthetic test data, not MantisGrid results."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Dashboard same-origin proxy to team service"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Service liveness plus explicit data/agent readiness",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/overview": {
      "get": {
        "operationId": "getOverview",
        "summary": "Source sample spending overview; not recoverable savings",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Overview"
                }
              }
            }
          },
          "502": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/recommendations": {
      "get": {
        "operationId": "listRecommendations",
        "summary": "Source judgments plus team audit availability",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recommendations"
                }
              }
            }
          },
          "502": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/audits": {
      "post": {
        "operationId": "createAudit",
        "summary": "Create immutable scenario audit; no infrastructure action",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Audit"
                }
              }
            }
          },
          "409": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuditRequest"
              }
            }
          }
        }
      }
    },
    "/api/audits/{audit_id}": {
      "get": {
        "operationId": "getAudit",
        "summary": "Read immutable audit snapshot",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Audit"
                }
              }
            }
          },
          "404": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "audit_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/audits/{audit_id}/evidence": {
      "get": {
        "operationId": "listAuditEvidence",
        "summary": "Page through audit-scoped evidence references",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidencePage"
                }
              }
            }
          },
          "404": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "audit_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/audits/{audit_id}/evidence/{evidence_id}": {
      "get": {
        "operationId": "getAuditEvidence",
        "summary": "Resolve a reference belonging to this audit",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceDetail"
                }
              }
            }
          },
          "404": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "audit_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "evidence_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/audits/{audit_id}/explanations": {
      "post": {
        "operationId": "explainAudit",
        "summary": "Bounded MCP-backed explanation; cannot alter audit",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Explanation"
                }
              }
            }
          },
          "404": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExplanationRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "audit_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/audits/{audit_id}/claims": {
      "get": {
        "operationId": "exportClaims",
        "summary": "Official-schema-compatible export of this exact audit",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Claims"
                }
              }
            }
          },
          "404": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "See documented error-code table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "audit_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "team",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "request_id": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "required": [
              "code",
              "message",
              "retryable",
              "request_id"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Provenance": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data_fingerprint": {
            "type": "string"
          },
          "sample_label": {
            "type": "string"
          },
          "window_label": {
            "type": "string"
          },
          "synthetic": {
            "type": "boolean"
          },
          "source_version": {
            "type": "string"
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "data_fingerprint",
          "sample_label",
          "window_label",
          "synthetic",
          "source_version",
          "caveats"
        ]
      },
      "Interval": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "low": {
            "type": "number",
            "minimum": 0
          },
          "point": {
            "type": "number",
            "minimum": 0
          },
          "high": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "low",
          "point",
          "high"
        ]
      },
      "RecoveryFractions": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "low": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "point": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "high": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "low",
          "point",
          "high"
        ]
      },
      "MoneyRange": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          },
          "unit": {
            "type": "string",
            "enum": [
              "reference_usd"
            ]
          },
          "values": {
            "$ref": "#/components/schemas/Interval"
          },
          "cash_savings_verified": {
            "const": false
          }
        },
        "required": [
          "currency",
          "unit",
          "values",
          "cash_savings_verified"
        ]
      },
      "Scenario": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recovery_fraction": {
            "$ref": "#/components/schemas/RecoveryFractions"
          },
          "usd_per_gpu_hour": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "cancelled_policy": {
            "type": "string",
            "enum": [
              "exclude"
            ]
          },
          "interval_kind": {
            "type": "string",
            "enum": [
              "scenario"
            ]
          },
          "assumption_note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "recovery_fraction",
          "usd_per_gpu_hour",
          "cancelled_policy",
          "interval_kind",
          "assumption_note"
        ]
      },
      "AuditRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expected_data_fingerprint": {
            "type": "string"
          },
          "recommendation_id": {
            "type": "string",
            "enum": [
              "cpu-placement-pilot"
            ]
          },
          "scenario": {
            "$ref": "#/components/schemas/Scenario"
          }
        },
        "required": [
          "client_request_id",
          "expected_data_fingerprint",
          "recommendation_id",
          "scenario"
        ]
      },
      "EvidenceRef": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "job",
              "gpu",
              "finding",
              "rule",
              "aggregate"
            ]
          },
          "source_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "synthetic": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind",
          "source_id",
          "label",
          "synthetic"
        ]
      },
      "Observation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "column": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "value",
          "unit",
          "column"
        ]
      },
      "EvidenceDetail": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "audit_id": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/components/schemas/EvidenceRef"
          },
          "source_table": {
            "type": "string"
          },
          "source_columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "join_keys": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "null"
              ]
            }
          },
          "observations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Observation"
            }
          },
          "method": {
            "type": "string"
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          }
        },
        "required": [
          "audit_id",
          "evidence",
          "source_table",
          "source_columns",
          "join_keys",
          "observations",
          "method",
          "caveats",
          "provenance"
        ]
      },
      "Downside": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "unmeasured",
              "scenario"
            ]
          },
          "mechanisms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "guardrails": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pilot_success_metrics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "money": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "money_unit": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "reference_usd",
              null
            ]
          }
        },
        "required": [
          "status",
          "mechanisms",
          "assumptions",
          "guardrails",
          "pilot_success_metrics",
          "money",
          "money_unit"
        ]
      },
      "Audit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "0.2"
          },
          "audit_id": {
            "type": "string"
          },
          "client_request_id": {
            "type": "string"
          },
          "recommendation_id": {
            "type": "string",
            "enum": [
              "cpu-placement-pilot"
            ]
          },
          "source_recommendation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "scenario": {
            "$ref": "#/components/schemas/Scenario"
          },
          "eligibility": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "definition": {
                "type": "string"
              },
              "unique_jobs": {
                "type": "integer",
                "minimum": 0
              },
              "eligible_gpu_hours": {
                "type": "number",
                "minimum": 0
              },
              "excluded_jobs": {
                "type": "integer",
                "minimum": 0
              },
              "overlapping_finding_references": {
                "type": "integer",
                "minimum": 0
              },
              "coverage_note": {
                "type": "string"
              }
            },
            "required": [
              "definition",
              "unique_jobs",
              "eligible_gpu_hours",
              "excluded_jobs",
              "overlapping_finding_references",
              "coverage_note"
            ]
          },
          "recovery": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "gpu_hours": {
                "$ref": "#/components/schemas/Interval"
              },
              "reference_usd": {
                "$ref": "#/components/schemas/MoneyRange"
              },
              "interval_kind": {
                "type": "string",
                "enum": [
                  "scenario"
                ]
              },
              "basis": {
                "type": "string"
              }
            },
            "required": [
              "gpu_hours",
              "reference_usd",
              "interval_kind",
              "basis"
            ]
          },
          "action": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "owner_role": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "proposed_pilot"
                ]
              },
              "compatibility_verified": {
                "const": false
              }
            },
            "required": [
              "title",
              "owner_role",
              "state",
              "compatibility_verified"
            ]
          },
          "downside": {
            "$ref": "#/components/schemas/Downside"
          },
          "evidence_preview": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvidenceRef"
            }
          },
          "evidence_count": {
